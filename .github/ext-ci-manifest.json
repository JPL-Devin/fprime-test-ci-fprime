{
  "upstream_repository": "JPL-Devin/fprime-test-ci-fprime",
  "check_prefix": "ext-ci",
  "paths_ignore": [
    "docs/**",
    "**.md"
  ],
  "repos": [
    {
      "id": "ext-a",
      "repository": "JPL-Devin/fprime-test-ci-ext-a",
      "workflow": "ci.yml",
      "default_ref": "main",
      "timeout_minutes": 30,
      "failure_policy": "block",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    },
    {
      "id": "ext-b",
      "repository": "JPL-Devin/fprime-test-ci-ext-b",
      "workflow": "ci.yml",
      "default_ref": "main",
      "timeout_minutes": 30,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    },
    {
      "id": "led-blinker",
      "repository": "fprime-community/fprime-workshop-led-blinker",
      "workflow": "ci.yml",
      "default_ref": "ext-ci-dispatch",
      "timeout_minutes": 90,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    },
    {
      "id": "zephyr-reference",
      "repository": "fprime-community/fprime-zephyr-reference",
      "workflow": "ci.yml",
      "default_ref": "ext-ci-dispatch",
      "timeout_minutes": 90,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    },
    {
      "id": "generic-hub-reference",
      "repository": "fprime-community/fprime-generic-hub-reference",
      "workflow": "ci.yml",
      "default_ref": "ext-ci-dispatch",
      "timeout_minutes": 90,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    }
  ]
}
